# Vercel Serverless Nodemailer Configuration
# Add these environment variables in your Vercel Project Settings > Environment Variables

# SMTP host (e.g., smtp.gmail.com, smtp.resend.com, smtp.sendgrid.net, etc.)
SMTP_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Your SMTP username / email address
SMTP_USER=your-email@gmail.com

# Your SMTP password / App Password (for Gmail, generate an "App Password" in Google Account Security)
SMTP_PASS=your-app-password

# Optional: recipient email where contact form submissions will be delivered
CONTACT_RECEIVER_EMAIL=your-destination-email@gmail.com
